# Copy to .env (gitignored). Every setting lives in api/src/icp_api/config.py.

ICP_DATABASE_URL=sqlite:///./icp.db

# Prometheus, e.g. after `make prom-forward`
ICP_PROMETHEUS_URL=http://localhost:9090

# Pin the kind cluster, so the API never acts on whatever context kubectl happens to be on.
ICP_KUBE_CONTEXT=kind-icp

# Running the API on your Mac against kind: `make proxy` starts `kubectl proxy`, and the
# control plane reaches each revision's Service through the API server's service proxy.
ICP_SERVICE_URL_TEMPLATE=http://127.0.0.1:8001/api/v1/namespaces/{namespace}/services/{service}:http/proxy

# Slurm (Northeastern Explorer). Leave the user empty until SSH key login works.
ICP_SLURM_SSH_USER=
ICP_SLURM_SSH_KEY_PATH=~/.ssh/icp_hpc
# ICP_SLURM_MODULE_LOAD=apptainer
